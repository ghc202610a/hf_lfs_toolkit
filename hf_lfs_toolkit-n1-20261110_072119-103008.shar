#!/bin/sh
set -eu
DEST=${1:-hf_lfs_toolkit-n1}
if [ -e "$DEST" ] || [ -L "$DEST" ]; then
    echo "Refusing to overwrite existing destination: $DEST" >&2
    exit 2
fi
mkdir -p "$DEST"
awk 'found { print } /^__PAYLOAD_BELOW__$/ { found=1 }' "$0" |
    base64 -d | tar -xz -C "$DEST"
echo "Extracted into: $DEST"
echo "Verify files with: (cd \"$DEST\" && sha256sum -c SHA256SUMS)"
exit 0
